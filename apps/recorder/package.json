{
  "name": "@workflow-capture-ai/recorder",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json && cpy \"src/index.html\" \"src/styles.css\" \"src/renderer.js\" dist --flat",
    "dev": "pnpm build && electron dist/main.js",
    "start": "pnpm build && electron dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workflow-capture-ai/schema": "workspace:*",
    "active-win": "^8.1.2",
    "screenshot-desktop": "^1.15.0",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "cpy-cli": "^5.0.0",
    "electron": "^35.3.0",
    "rimraf": "^6.0.1"
  }
}
